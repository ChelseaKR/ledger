# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Local runtime data — an archive's bags, store, and vault must never be committed.
# These hold contributor records and (encrypted) identity material. Keeping them out
# of version control is part of the no-outing guarantee, not a convenience.
/var/
*.ledgerstore/
*.vault
*.bag/
instance/
local-archive/

# Secrets — never commit. See SECURITY.md.
.env
.env.*
*.key
*.pem
secrets/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code session tooling (not part of the project)
.claude/

# runtime-fetched portfolio-standards (never commit)
.standards/

# Third-party archival corpus fetched by `make real-corpus` (tools/real_corpus.py).
# Hundreds of megabytes of someone else's files; re-fetched on demand from a pinned
# commit and verified by SHA-1, so it never belongs in this repository's history.
/real-corpus/

# Mutation testing (mutmut) — advisory only (CQ-47); its working copy and stats
# are regenerated every `make mutation` run and never committed.
mutants/
.mutmut-cache
mutmut-stats.json
mutmut-cicd-stats.json

# Ideation planning notes (docs/ideation/). `main` carries exactly one of the five —
# 02-large-scale-fixes.md, whose FIX-NN ids are cited from ADRs, issues, and the
# roadmap, so a reader following a reference can open it. The other four are working
# notes main has never carried, and that boundary used to exist only as absence.
# See "Planning notes: what docs/ideation/ publishes" in CONTRIBUTING.md — including
# why this is not a retraction: all five are already public on the rescue/* branches.
/docs/ideation/*
!/docs/ideation/02-large-scale-fixes.md
