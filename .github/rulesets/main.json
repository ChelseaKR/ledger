{
  "name": "protect-main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "lint · type · test (py3.12)" },
          { "context": "dependency & secret scan" },
          { "context": "no-outing audit (safety gate)" },
          { "context": "accessibility gate (WCAG 2.2 AA)" },
          { "context": "accessibility (browser axe over the served site)" },
          { "context": "i18n (gettext catalog gate)" },
          { "context": "workflow linter (zizmor)" },
          { "context": "performance budgets (QM-02)" },
          { "context": "container image CVE scan (Trivy)" },
          { "context": "CodeQL analyze (python)" },
          { "context": "CodeQL analyze (actions)" },
          { "context": "OSV lockfile scan (uv.lock)" },
          { "context": "Semgrep SAST (p/ci)" }
        ]
      }
    },
    { "type": "required_linear_history" },
    { "type": "required_signatures" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": true,
        "required_reviewers": [],
        "allowed_merge_methods": ["merge", "squash", "rebase"]
      }
    }
  ],
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
  ]
}
